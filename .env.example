# =====================================================================
# TradeOrbit - root .env.example (Root Environment Variable Template)
# Scopes: ROOT SHARED | BACKEND ONLY | FRONTEND PUBLIC | LOCAL COMPOSE |
#         CONDITIONAL | DEFERRED (commented)
# No real credentials. No JWT_SECRET (G2: opaque Redis sessions).
# G1-G8 unchanged. G4 values below are approved defaults; do not change.
#
# LOADING RULE: this root file is documentation only. It does NOT itself
# configure pnpm workspace variable loading. Each application/worker must
# load its own scoped environment at runtime. Frontend applications may
# expose only browser-safe public variables (NEXT_PUBLIC_*). Backend
# secrets must remain available only to the API and workers.
# =====================================================================

# ---------------- ROOT SHARED (all applications) ----------------
APP_ENV=local                       # REQUIRED: local | test | staging | production
NODE_ENV=development                # REQUIRED: development | test | production
API_BASE_URL=                       # REQUIRED: public versioned API base URL
WEB_BASE_URL=                       # REQUIRED: storefront origin (links, CORS)
ADMIN_BASE_URL=                     # REQUIRED: separate admin portal origin (G7)
CORS_ALLOWED_ORIGINS=               # REQUIRED: explicit origins; no wildcard with credentials

# ---------------- FRONTEND PUBLIC (browser-safe only) ----------------
NEXT_PUBLIC_API_URL=                # REQUIRED: Web + Admin client-side API URL

# ---------------- BACKEND ONLY (API and workers only) ----------------
DATABASE_URL=                       # REQUIRED: Prisma / PostgreSQL
REDIS_URL=                          # REQUIRED: sessions, cache, rate limits, queues

SESSION_COOKIE_NAME=tradeorbit_session
SESSION_COOKIE_DOMAIN=              # CONDITIONAL: parent domain of API host, same-site only
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SAME_SITE=lax        # lax same-site default; "none" only cross-site + SECURE=true
SESSION_COOKIE_SECURE=true          # true in test/staging/production; local HTTP dev only may false

# Token hashing: approved plan permits SHA-256 or HMAC with a server-side pepper.
# SHA-256 token hashing does not require a pepper.
# HMAC token hashing requires TOKEN_HASH_PEPPER.
# This proposal does not choose an algorithm beyond the approved plan.
TOKEN_HASH_PEPPER=                  # CONDITIONAL: HMAC token hashing only

# MFA keys: local development may use a locally supplied development key.
# Production keys must be supplied through an approved secrets/key-management system.
# Never use placeholder or committed keys in production.
# No cloud provider or key-management product is selected here.
MFA_ENCRYPTION_KEY=                 # REQUIRED for MFA-enabled deployment (AES-256-GCM per plan)
MFA_ENCRYPTION_KEY_ID=              # REQUIRED with key (key ID/version stored)
MFA_ENCRYPTION_PREVIOUS_KEYS_JSON=  # CONDITIONAL: rotation only

EMAIL_FROM_ADDRESS=                 # CONDITIONAL: required when verification/reset email enabled
EMAIL_FROM_NAME=TradeOrbit
EMAIL_PROVIDER=                     # CONDITIONAL: optional until provider is selected
EMAIL_API_KEY=                      # CONDITIONAL: provider credential; leave empty until selected

# ---- Approved G4 auth config (OPTIONAL defaults; overrides need security approval) ----
AUTH_PASSWORD_HASH_MEMORY_KIB=19456
AUTH_PASSWORD_HASH_ITERATIONS=2
AUTH_PASSWORD_HASH_PARALLELISM=1
AUTH_CUSTOMER_SESSION_IDLE_TTL_HOURS=12
AUTH_CUSTOMER_SESSION_ABSOLUTE_TTL_DAYS=30
AUTH_PRIVILEGED_SESSION_IDLE_TTL_MINUTES=30
AUTH_PRIVILEGED_SESSION_ABSOLUTE_TTL_HOURS=8
AUTH_VERIFICATION_TOKEN_TTL_HOURS=24
AUTH_PASSWORD_RESET_TOKEN_TTL_HOURS=1
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_MAX_FAILED_MFA_ATTEMPTS=5
AUTH_RECOVERY_CODE_COUNT=10
AUTH_TOTP_DIGITS=6
AUTH_TOTP_PERIOD_SECONDS=30
AUTH_TOTP_DRIFT_STEPS=1
AUTH_VERIFICATION_RESEND_PER_HOUR=1
AUTH_VERIFICATION_RESEND_PER_DAY=3
AUTH_LOGIN_HISTORY_RETENTION_DAYS=90
AUTH_AUDIT_EVENT_RETENTION_DAYS=365
AUTH_REVOKED_SESSION_RETENTION_DAYS=90
AUTH_DELIVERY_MFA_POLICY=CONFIGURABLE   # G1; change requires approval + audit

# ---------------- CONDITIONAL: object-storage features ----------------
# Needed only when media uploads, KYC documents, invoices, or exports are enabled;
# do not require at API boot. Private files use signed URLs.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# ---------------- CONDITIONAL: optional Google sign-in (G6) ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ---------------- CONDITIONAL: observability ----------------
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# ---------------- LOCAL DOCKER COMPOSE ONLY (never staging/production) ----------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_PASSWORD=

# ---------------- DEFERRED: commented placeholders; do not set ----------------
# Payment provider / credentials / webhook secret                  (DEC-004, DEC-018)
# Shipping provider / credentials / webhook secret                 (DEC-005)
# Tax provider / credentials / tax source                          (DEC-001, DEC-022)
# Commission, settlement, reserve, payout policy values            (DEC-006)
# SMS provider / credentials / sender                              (INT-SMS)
# Search index URL / credentials                                   (DEC-015)
# CDN provider token                                               (DEC-009, TEC-012)
# Maps provider key                                                (INT-MAPS, conditional)
# Default locale / currency / tax region                           (DEC-007)
# Live-chat, blog, loyalty, affiliate, mobile, B2B, multi-warehouse (DEC-016/017/024)
# Guest-order eligibility rules                                    (G5, DEC-029)
# Partial-session TTL / guest-identity TTL                         (G4/G5 detail unresolved)
# Page size, request/upload size, idempotency TTL, webhook tolerance (DEC-020, API-ENV-005)
# Retention job schedule / legal-hold behaviour                    (legal/security sign-off)
